QMainWindow, QWidget {
    background-color: {{BG_ROOT}};
    color: {{TEXT_PRIMARY}};
    font-family: '{{font_family}}', 'Inter', sans-serif;
    font-size: {{font_size}}px;
}

QWidget#main {
    background-color: {{BG_ROOT}};
}

QWidget#content {
    background-color: {{BG_ROOT}};
}

QPushButton {
    border-radius: {{RADIUS_MD}};
    padding: {{SPACING_LG}};
    border: 1px solid {{BORDER}};
    background-color: {{BG_ELEVATED}};
    color: {{TEXT_PRIMARY}};
}

QPushButton:hover {
    border-color: {{BORDER_HOVER}};
}

QPushButton:pressed {
    background-color: {{BG_SURFACE}};
}

QPushButton#btn-primary {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 {{PRIMARY}},stop:1 {{SECONDARY}});
    border: none;
    border-radius: {{RADIUS_MD}};
    color: #FFFFFF;
    padding: {{SPACING_LG}};
    font-weight: 600;
}

QPushButton#btn-primary:hover {
    border: 1px solid rgba({{ACCENT_RGB}},0.5);
}

QPushButton#btn-primary:pressed {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 {{PRIMARY}},stop:1 {{SECONDARY}});
}

QPushButton#btn-ghost,
QPushButton#btn-secondary {
    background: transparent;
    border: 1px solid rgba({{SECONDARY_RGB}},0.35);
    color: {{SECONDARY}};
}

QPushButton#btn-ghost:hover,
QPushButton#btn-secondary:hover {
    border-color: {{SECONDARY}};
    background: rgba({{SECONDARY_RGB}},0.07);
}

QPushButton#btn-danger {
    background: rgba({{ERROR_RGB}},0.15);
    border: 1px solid rgba({{ERROR_RGB}},0.3);
    color: {{ERROR}};
}

QPushButton#btn-danger:hover {
    background: rgba({{ERROR_RGB}},0.3);
}

QPushButton#btn-flat {
    background: transparent;
    border: none;
    color: {{TEXT_HINT}};
    padding: {{SPACING_SM}};
}

QPushButton#btn-flat:hover {
    color: {{TEXT_PRIMARY}};
    background: rgba({{TEXT_PRIMARY_RGB}},0.06);
    border-radius: {{RADIUS_SM}};
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QComboBox {
    background: {{BG_SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MD}};
    padding: {{SPACING_MD}};
    selection-background-color: rgba({{SECONDARY_RGB}},0.28);
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QComboBox:hover {
    border-color: {{BORDER_HOVER}};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QComboBox:focus {
    border: 1px solid {{SECONDARY}};
    padding: {{SPACING_MD}};
}

QLineEdit[error='true'],
QLineEdit[invalid='true'],
QDateEdit[invalid='true'],
QDoubleSpinBox[invalid='true'],
QComboBox[invalid='true'] {
    border: 1px solid {{ERROR}};
    background: rgba({{ERROR_RGB}},0.06);
}

QListWidget,
QTableWidget,
QTreeWidget {
    background: {{BG_SURFACE}};
    border: 1px solid {{BG_ELEVATED}};
    border-radius: {{RADIUS_LG}};
    color: {{TEXT_SECONDARY}};
    gridline-color: {{BORDER}};
}

QListWidget::item,
QTableWidget::item,
QTreeWidget::item {
    padding: {{SPACING_MD}};
    color: {{TEXT_SECONDARY}};
}

QListWidget::item:hover,
QTableWidget::item:hover,
QTreeWidget::item:hover {
    background: rgba({{SECONDARY_RGB}},0.07);
    color: {{TEXT_PRIMARY}};
}

QListWidget::item:selected,
QTableWidget::item:selected,
QTreeWidget::item:selected {
    background: rgba({{SECONDARY_RGB}},0.12);
    color: {{ACCENT}};
    border-left: 3px solid {{SECONDARY}};
}

QHeaderView::section {
    background: {{BG_ELEVATED}};
    color: {{TEXT_SECONDARY}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
    padding: {{SPACING_SM}};
}

QTabWidget::pane {
    border: 1px solid {{BG_ELEVATED}};
    border-radius: {{RADIUS_LG}};
    margin-top: 8px;
}

QTabBar::tab {
    background: {{BG_SURFACE}};
    border-bottom: 2px solid transparent;
    padding: {{SPACING_LG}};
    color: {{TEXT_HINT}};
}

QTabBar::tab:hover {
    color: {{TEXT_SECONDARY}};
}

QTabBar::tab:selected {
    color: {{ACCENT}};
    border-bottom-color: {{SECONDARY}};
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
}

QScrollBar:vertical {
    width: 6px;
}

QScrollBar:horizontal {
    height: 6px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: {{BORDER}};
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: {{SECONDARY}};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QProgressBar {
    background: {{BG_ELEVATED}};
    border: none;
    border-radius: 100px;
    min-height: 8px;
    max-height: 8px;
    text-align: center;
    color: {{TEXT_PRIMARY}};
}

QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 {{PRIMARY}},stop:0.5 {{SECONDARY}},stop:1 {{ACCENT}});
    border-radius: 100px;
}

QGroupBox {
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_LG}};
    margin-top: 20px;
    padding: 16px;
}

QGroupBox::title {
    color: {{SECONDARY}};
    background: transparent;
    padding: 0 8px;
    subcontrol-origin: margin;
    subcontrol-position: top left;
}

QLabel#label-title {
    font-size: 22px;
    font-weight: 600;
    color: {{TEXT_PRIMARY}};
}

QLabel#label-section {
    font-size: 11px;
    font-weight: 600;
    color: {{PRIMARY}};
    text-transform: uppercase;
}

QLabel#label-muted {
    color: {{TEXT_HINT}};
    font-size: 12px;
}

QLabel#label-value {
    font-size: 28px;
    font-weight: 700;
    color: {{ACCENT}};
}

QLabel#label-error {
    color: {{ERROR}};
    font-size: 11px;
}

QMenuBar {
    background: {{BG_ROOT}};
    color: {{TEXT_SECONDARY}};
}

QMenuBar::item {
    padding: {{SPACING_SM}};
}

QMenuBar::item:selected {
    background: rgba({{SECONDARY_RGB}},0.1);
    color: {{TEXT_PRIMARY}};
}

QMenu {
    background: {{BG_SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_LG}};
    color: {{TEXT_SECONDARY}};
}

QMenu::item {
    padding: {{SPACING_SM}};
}

QMenu::item:selected {
    background: rgba({{SECONDARY_RGB}},0.1);
    color: {{ACCENT}};
}

QStatusBar {
    background: {{BG_ROOT}};
    border-top: 1px solid {{BG_ELEVATED}};
    color: {{TEXT_HINT}};
}

QToolTip {
    background: {{BG_ELEVATED}};
    border: 1px solid {{SECONDARY}};
    color: {{TEXT_PRIMARY}};
    border-radius: {{RADIUS_SM}};
    padding: {{SPACING_SM}};
}

QWidget#sidebar {
    background: {{BG_ROOT}};
    border-right: 1px solid {{BG_ELEVATED}};
}

QLabel#sidebar-logo {
    font-size: 20px;
    font-weight: 700;
    color: {{ACCENT}};
    padding: 18px 16px 10px 16px;
}

QLabel#sidebar-section {
    color: {{TEXT_HINT}};
    font-size: 11px;
    text-transform: uppercase;
    padding: 10px 16px 8px 16px;
}

QPushButton#pill-duration {
    background: {{BG_SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 100px;
    padding: {{SPACING_SM}};
    color: {{TEXT_HINT}};
    font-size: 11px;
}

QPushButton#pill-duration:hover {
    border-color: {{SECONDARY}};
    color: {{SECONDARY}};
}

QTabWidget#finance-tabs QTabBar::tab {
    border-radius: {{RADIUS_MD}};
    margin-right: 6px;
    padding: {{SPACING_MD}};
}

QTabWidget#finance-tabs QTabBar::tab:selected {
    background: rgba({{SECONDARY_RGB}},0.12);
    border: 1px solid rgba({{SECONDARY_RGB}},0.35);
    border-bottom-color: {{SECONDARY}};
}

QTableWidget#finance-table {
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_LG}};
}

QFrame#alert-banner {
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_LG}};
    background: {{BG_SURFACE}};
}

QFrame#alert-banner[level='success'] {
    border-color: rgba({{SUCCESS_RGB}},0.45);
    background: rgba({{SUCCESS_RGB}},0.08);
}

QFrame#alert-banner[level='warning'] {
    border-color: rgba({{WARNING_RGB}},0.45);
    background: rgba({{WARNING_RGB}},0.08);
}

QFrame#alert-banner[level='error'] {
    border-color: rgba({{ERROR_RGB}},0.45);
    background: rgba({{ERROR_RGB}},0.08);
}

QLabel#alert-level {
    color: {{ACCENT}};
    font-weight: 700;
    font-size: 11px;
}

QLabel#alert-message {
    color: {{TEXT_PRIMARY}};
}

QLabel#summary-card-value {
    font-size: 24px;
    font-weight: 700;
    color: {{ACCENT}};
}

QLabel#summary-card-subtitle {
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
}

QWidget#drop-zone {
    border: 2px dashed rgba({{SECONDARY_RGB}},0.45);
    border-radius: {{RADIUS_LG}};
    background: rgba({{SECONDARY_RGB}},0.05);
}

QLabel#drop-zone-title {
    color: {{TEXT_PRIMARY}};
    font-weight: 600;
}

QLabel#drop-zone-subtitle {
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
}

QLabel#finance-status {
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
    font-weight: 600;
}

QPushButton#pill-duration:checked {
    background: rgba({{SECONDARY_RGB}},0.15);
    border-color: {{SECONDARY}};
    color: {{ACCENT}};
}

QWidget#mode-tab-container {
    background: {{BG_SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_LG}};
    padding: 4px;
}

QPushButton#mode-tab {
    background: transparent;
    color: {{TEXT_HINT}};
    border-radius: {{RADIUS_SM}};
    border: none;
    padding: {{SPACING_SM}};
}

QPushButton#mode-tab:hover {
    color: {{TEXT_SECONDARY}};
}

QPushButton#mode-tab[active='true'] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 {{PRIMARY}},stop:1 {{SECONDARY}});
    color: #FFFFFF;
}

QPushButton#btn-sec {
    background: transparent;
    border: 1px solid rgba({{SECONDARY_RGB}},0.35);
    color: {{SECONDARY}};
}

QPushButton#btn-sec:hover {
    border-color: {{SECONDARY}};
    background: rgba({{SECONDARY_RGB}},0.07);
}
