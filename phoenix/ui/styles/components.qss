QScrollArea {
    border: none;
}
QTableWidget {
    gridline-color: #334155;
    selection-background-color: #2563eb;
}
QHeaderView::section {
    padding: 10px;
    border: none;
    background: transparent;
    font-weight: 600;
}
QProgressBar {
    border: none;
    border-radius: 8px;
    background: #1f2937;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: #22c55e;
}

QLabel#toast {
    color: #f8fafc;
    font-weight: 600;
    border-radius: 10px;
    border: 1px solid #334155;
    background: #1e293b;
}

QLabel#toast[kind="success"] {
    background: #065f46;
    border-color: #10b981;
}

QLabel#toast[kind="warning"] {
    background: #78350f;
    border-color: #f59e0b;
}

QLabel#toast[kind="error"] {
    background: #7f1d1d;
    border-color: #ef4444;
}

QLineEdit[invalid="true"],
QTextEdit[invalid="true"],
QComboBox[invalid="true"],
QSpinBox[invalid="true"],
QDoubleSpinBox[invalid="true"] {
    border: 1px solid #ef4444;
}

QLabel#header-hint {
    font-size: 11px;
    color: #94a3b8;
}

QPushButton#nav-item {
    transition: all 0.2s ease;
}
